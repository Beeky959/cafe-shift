{
  "name": "byte-builds-cafe-shift",
  "version": "0.3.0-m0",
  "private": true,
  "description": "Byte Builds: Café Shift. Browser café-management game. Milestone M0 scaffold.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test \"test/**/*.test.js\"",
